# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.web.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set to true to run against the local Firebase emulators instead (no Firebase project needed).
VITE_USE_EMULATORS=false

# Push notifications (optional). See README → Notifications.
# Public VAPID key from `npm run vapid`, and the URL of your deployed Cloudflare Worker.
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_URL=https://fridgeboard-push.your-subdomain.workers.dev

# Optional: the Gemini model that reads receipts. Change it if Google retires the default.
# VITE_GEMINI_MODEL=gemini-3.6-flash
