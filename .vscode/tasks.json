          "activesBegin": true,
          "beginsPattern": "Starting emulators",
          "endsPattern": "All emulators ready"
        }
      },
      "presentation": { "group": "local" }
    },
    {
      "label": "App (local)",
      "type": "npm",
      "script": "dev:local",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x^" },
