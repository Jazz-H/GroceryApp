      "presentation": { "group": "local" }
    },
    {
      "label": "Run Fridgeboard locally",
      "dependsOn": ["Emulators", "App (local)"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Rule tests (emulator)",
      "type": "npm",
      "script": "test:rules",
      "group": "test",
      "problemMatcher": []
    }
  ]
