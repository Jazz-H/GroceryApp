rules_version = '2';

// Stocked security rules.
// - Only members of a household can read or write anything in it.
// - Joining needs the household's current invite code.
// - The activity log is append-only: entries can be created by their actor, never edited or deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && uid() in household(hid).memberIds;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Voice add ----
    // A Siri Shortcut (through the relay) adds items with no sign-in, carrying a voice key
    // "<householdId>.<uid>.<secret>". Only its SHA-256 is stored, in voiceKeys/{hash}, by the
    // member it belongs to. A write is accepted only if that hash exists in this household and
    // belongs to the member the write is credited to.
    function voiceKeyPath(hid, key) {
      return /databases/$(database)/documents/households/$(hid)/voiceKeys/$(hashing.sha256(key).toHexString().lower());
    }

    function voiceAdd(hid, d, who) {
      return request.auth == null
        && d.voiceKey is string
        && d.voiceKey.size() >= 40 && d.voiceKey.size() <= 200
        && d.voiceKey.split('[.]')[0] == hid
        && d.voiceKey.split('[.]')[1] == who
        && exists(voiceKeyPath(hid, d.voiceKey))
        && get(voiceKeyPath(hid, d.voiceKey)).data.uid == who
        && who in household(hid).memberIds;
    }

    // ---- Users: your own profile only ----
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---- Invite codes: anyone signed in can look up one code, never list them ----
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy'])
        && request.resource.data.createdBy == uid()
        && uid() in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberIds
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code;
      allow delete: if isMember(resource.data.householdId);
      allow update: if false;
    }

    // ---- Households ----
    match /households/{hid} {
      allow read: if isMember(hid);

      // Create: you are the only member.
      allow create: if signedIn()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.inviteCode is string;

      // Join: add only yourself, proving you know the current invite code.
      allow update: if signedIn()
        && !(uid() in resource.data.memberIds)
        && changed().hasOnly(['memberIds', 'members', 'joinCode'])
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.memberIds == resource.data.memberIds.concat([uid()])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
        && resource.data.memberIds.size() < 6;

      // Members can change settings, but the member list only by leaving.
      allow update: if isMember(hid)
        && (
          request.resource.data.memberIds == resource.data.memberIds
          || request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow delete: if false;

      // ---- Items ----
      match /items/{itemId} {
        function validItem(d) {
          return d.name is string && d.name.size() > 0 && d.name.size() <= 120
            && d.list in ['grocery', 'nice']
            && d.status in ['open', 'checked', 'ordered']
            && d.stores is list && d.stores.size() > 0 && d.stores.size() <= 3
            && d.qty is number && d.qty >= 1 && d.qty <= 999
            && (!('category' in d) || (d.category is string && d.category.size() <= 20));
        }

        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && validItem(request.resource.data)
          && request.resource.data.createdBy == uid()
          && request.resource.data.updatedBy == uid();
        // Added by voice: an open grocery item credited to the voice key's owner.
        allow create: if validItem(request.resource.data)
          && voiceAdd(hid, request.resource.data, request.resource.data.createdBy)
          && request.resource.data.via == 'voice'
          && request.resource.data.updatedBy == request.resource.data.createdBy
          && request.resource.data.status == 'open'
          && request.resource.data.list == 'grocery'
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(hid)
          && validItem(request.resource.data)
          && request.resource.data.updatedBy == uid()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(hid);
      }

      // ---- Activity log: append-only ----
      match /activity/{eventId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.actorId == uid()
          && request.resource.data.at == request.time
          && request.resource.data.type in ['add', 'edit', 'check', 'uncheck', 'move', 'delete', 'trip_start', 'trip_join', 'trip_end', 'receipt', 'order', 'pickup']
          && request.resource.data.itemNames is list
          && request.resource.data.itemNames.size() <= 50;
        // The matching log entry for a voice add, created in the same commit as the item.
        allow create: if voiceAdd(hid, request.resource.data, request.resource.data.actorId)
          && request.resource.data.at == request.time
          && request.resource.data.type == 'add'
          && request.resource.data.detail == 'voice'
          && request.resource.data.itemIds.size() == 1
          && request.resource.data.itemNames.size() == 1
          && getAfter(/databases/$(database)/documents/households/$(hid)/items/$(request.resource.data.itemIds[0])).data.voiceKey == request.resource.data.voiceKey;
        allow update, delete: if false;
      }

      // ---- Push subscriptions: one per phone ----
      // Members can read them (the relay reads with the sender's token) and delete dead ones.
      // Only the owner can create or change their own.
      match /pushSubs/{subId} {
        function validSub(d) {
          return d.uid == uid()
            && d.endpoint is string && d.endpoint.matches('https://.+') && d.endpoint.size() < 1000
            && d.p256dh is string && d.p256dh.size() < 200
            && d.auth is string && d.auth.size() < 100
            && d.prefs is map;
        }
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validSub(request.resource.data);
        allow update: if isMember(hid) && resource.data.uid == uid() && validSub(request.resource.data);
      }

      // ---- Trips ----
      match /trips/{tripId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.startedBy == uid()
          && request.resource.data.status == 'active';
        allow update: if isMember(hid)
          && request.resource.data.startedBy == resource.data.startedBy;
        allow delete: if false;
      }

      // ---- Receipts: any member can add, fix or remove them ----
      match /receipts/{receiptId} {
        function validReceipt(d) {
          return d.store in ['ht', 'target', 'amazon', 'other']
            && d.purchasedAt is number
            && d.totalCents is int
            && d.lines is list && d.lines.size() <= 150
            && d.paidBy in household(hid).memberIds;
        }

        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && validReceipt(request.resource.data)
          && request.resource.data.createdBy == uid();
        allow update: if isMember(hid)
          && validReceipt(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(hid);
      }

      // ---- Catalog: everything ever added, for "usuals" suggestions ----
      match /catalog/{key} {
        allow read: if isMember(hid);
        allow write: if isMember(hid)
          && (request.resource == null
            || (request.resource.data.name is string
              && request.resource.data.name.size() <= 120
              && request.resource.data.count is number
              && (!('category' in request.resource.data)
                || (request.resource.data.category is string
                  && request.resource.data.category.size() <= 20))));
      }

      // ---- Settle up: one member paid the other back ----
      match /settlements/{id} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.by == uid()
          && request.resource.data.from in household(hid).memberIds
          && request.resource.data.to in household(hid).memberIds
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.cents is int
          && request.resource.data.cents > 0
          && request.resource.data.cents < 10000000;
        allow update: if false;
      }

      // ---- Voice keys: SHA-256 of each member's Siri Shortcut key (see voiceAdd) ----
      match /voiceKeys/{hash} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && hash.matches('[0-9a-f]{64}')
          && request.resource.data.keys().hasOnly(['uid', 'label', 'createdAt'])
          && request.resource.data.uid == uid()
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 40;
        allow update: if false;
      }

      // ---- Remembered barcodes (UPC → item name) ----
      match /barcodes/{code} {
        allow read: if isMember(hid);
        allow write: if isMember(hid)
          && (request.resource == null
            || (request.resource.data.name is string
              && request.resource.data.name.size() <= 120));
      }

      // ---- Remembered receipt matches ("HT ORG SPINACH" → Spinach) ----
      match /aliases/{key} {
        allow read: if isMember(hid);
        allow write: if isMember(hid)
          && (request.resource == null || request.resource.data.itemId is string);
      }
    }
  }
}
